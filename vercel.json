{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "(?i)^(www\\.)?webbroskidev\\.pl$"
        }
      ],
      "destination": "https://brosystems.pl/$1",
      "statusCode": 301
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}